# DeskMed backend environment — copy to .env and fill in real values.
# Never commit the real .env (it is gitignored).

# PostgreSQL connection (Prisma reads this via prisma.config.ts and the pg adapter)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/deskmed?schema=public"

# JWT signing secrets — use long random strings in real environments
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Comma-separated allowed origins (dashboard + landing)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# API port
PORT="4000"
